# Copy to .env for local overrides; `pnpm dev` loads it. In production set these on the host (Render).

# Port the API listens on.
PORT=3000

# Origin of the web app allowed to call the API from the browser (scheme + host + port, no trailing slash).
# Needed in dev only if the web calls the API directly (VITE_API_URL=http://localhost:3000) instead of through the /api proxy.
# Production: the deployed web origin, e.g. https://lino.example.com
CORS_ORIGIN=http://localhost:5173

# Set to 1 only behind one reverse proxy (Render, Vercel), so rate limiting uses the client IP that proxy saw.
# TRUST_PROXY=1

# Postgres for shared boards. Local: `docker compose up -d` at the repo root. Without it the API runs but sharing answers 503.
# Production: the managed Postgres connection string (Neon, Render, Supabase).
DATABASE_URL=postgres://lino:lino@localhost:5432/lino

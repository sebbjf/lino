# Copy to .env for local overrides; `pnpm dev` loads it. In production set these on the host (Render).

# Port the API listens on.
PORT=3000

# Origin of the web app allowed to call the API from the browser. Unset = no CORS header (fine in dev, the Vite proxy is same-origin).
# CORS_ORIGIN=https://lino.example.com

# Set to 1 only behind a reverse proxy (Render), so rate limiting uses the client IP from X-Forwarded-For.
# TRUST_PROXY=1

# Copy to .env.local for local overrides. Vite exposes only VITE_* variables to the browser: never put secrets here.

# Base URL of the API. Defaults to /api, which the dev server proxies to http://localhost:3000.
# Calling the API directly needs CORS_ORIGIN=http://localhost:5173 in apps/api/.env.
# VITE_API_URL=http://localhost:3000
